# Backend environment variables.
# Copy file này thành `.env` ở cùng folder, điền giá trị thật.
# `.env` đã được .gitignore — KHÔNG bao giờ commit file `.env` thật.
#
# Sinh secret (32 bytes base64) trên Linux/Mac:   openssl rand -base64 32
# Trên PowerShell:                                [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))

# ---------- Spring Profile ----------
# dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# ---------- Database (PostgreSQL) ----------
# DB_HOST/PORT cho backend khi chạy ngoài Docker (localhost).
# Khi backend chạy trong docker-compose Phase 7: DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobtracker
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- JWT ----------
# JWT_SECRET phải đủ 32 bytes (256 bits) cho HS256. KHÔNG dùng giá trị placeholder ở prod.
JWT_SECRET=CHANGE_ME_to_a_32_byte_random_base64_string_xxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800

# ---------- Google OAuth ----------
# Tạo OAuth Client ID tại: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/auth/callback (dev)
# Scopes Phase 1: email, profile
# Scopes Phase 6 (Gmail): thêm gmail.readonly, gmail.send, gmail.modify
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# ---------- AI (Google Gemini) ----------
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# gemini-1.5-flash đã deprecated (404 trên v1beta). Dùng model hiện hành:
GEMINI_MODEL=gemini-2.0-flash

# ---------- Email (SMTP) — Phase 6 ----------
# Dev: tạo inbox ảo miễn phí tại https://mailtrap.io (Email Testing → SMTP).
#   Copy Host/Port/Username/Password vào đây. Email KHÔNG gửi ra ngoài thật,
#   chỉ nằm trong inbox Mailtrap để xem — an toàn khi test.
# Prod / muốn gửi thật: dùng SMTP thật (vd Gmail App Password, Brevo, Resend).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Địa chỉ hiển thị ở dòng "From" của email hệ thống.
MAIL_FROM=Job Tracker AI <no-reply@jobtracker.ai>

# ---------- Encryption ----------
# Dùng để encrypt Gmail refresh token trước khi lưu DB (AES-256-GCM).
# 32 bytes base64.
ENCRYPTION_KEY=CHANGE_ME_to_a_32_byte_random_base64_string_yyyyyyyyyyyyyyyyyyyyy

# ---------- File Storage (Phase 2) ----------
# Dev: lưu local. Folder mặc định: ~/job-tracker-uploads/ (set qua APP_STORAGE_LOCAL_PATH).
APP_STORAGE_LOCAL_PATH=

# Phase 7 (prod deploy với Cloudinary). Để trống ở dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- CORS ----------
# Comma-separated list các origin frontend được phép gọi backend.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
