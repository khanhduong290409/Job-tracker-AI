# Frontend environment variables (Vite).
# Copy file này thành `.env` ở cùng folder `frontend/`, điền giá trị thật.
# `.env` đã được .gitignore — KHÔNG bao giờ commit file `.env` thật.
#
# LƯU Ý: chỉ vars có prefix `VITE_` mới được Vite expose ra client code.
# KHÔNG đặt secrets (JWT, API key backend, DB password) vào đây — frontend chạy ở browser, ai cũng đọc được.

# ---------- Backend API ----------
# URL gốc của backend, đã bao gồm /api/v1 để các API call chỉ cần ghép path tương đối.
# Dev: backend chạy localhost:8080. Prod (Phase 7): đổi sang domain thật.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---------- Google OAuth ----------
# Cùng giá trị với GOOGLE_CLIENT_ID ở backend `.env`. Client ID public theo OAuth spec, không phải secret.
# Để trống ở Phase 0, điền khi làm Login UI ở Phase 1.
VITE_GOOGLE_CLIENT_ID=

# ---------- App ----------
# Tên hiển thị ở <title>, header, email subject, v.v.
VITE_APP_NAME=Applyist
